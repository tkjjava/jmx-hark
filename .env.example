# hark-bridge 配置示例
# 复制为 .env 后填写，或用环境变量直接设置。
# 注意：本项目不读取 .env 文件，这些只是给你的配置参考。
#       要用 .env 的话请配合 python-dotenv 或系统的环境变量机制。

# ---- 必填 ------------------------------------------------------------

# 会话加密密钥。缺失会直接报错，不会退化成明文存储。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HARK_BRIDGE_KEY=

# ---- 存储 ------------------------------------------------------------

# 账号库路径
HARK_BRIDGE_DB=./data/accounts.db

# ---- 服务 ------------------------------------------------------------

# 监听地址。默认只听本地，不要改成 0.0.0.0 除非你清楚风险
HARK_BRIDGE_HOST=127.0.0.1
HARK_BRIDGE_PORT=8787

# 客户端密钥，逗号分隔。留空则不校验（仅限本地使用）
# HARK_BRIDGE_API_KEYS=sk-my-key-1,sk-my-key-2
HARK_BRIDGE_API_KEYS=

# ---- 上游 ------------------------------------------------------------

HARK_BASE=https://hark.com

# 回复读取方式：history（默认，最可靠）/ search / none
HARK_REPLY_MODE=history

# 等回复超时（秒）
HARK_REPLY_TIMEOUT=120

# 失败账号冷却时长（秒）
HARK_BRIDGE_COOLDOWN=60

# ---- 端点覆盖（上游变更时用）----------------------------------------
# 默认值已按已知形态填好，一般不需要改。
# HARK_PATH_SEND_MESSAGE=/api/messages/send
# HARK_PATH_HISTORY=/api/messages/history
# HARK_PATH_LIST_CONVERSATIONS=/api/conversations
# HARK_PATH_CREATE_CONVERSATION=/api/conversations
# HARK_PATH_SESSION_PROBE=/api/auth/get-session
# HARK_PATH_BILLING_SUMMARY=/api/billing/summary
